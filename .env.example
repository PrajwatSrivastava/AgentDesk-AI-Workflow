# Copy to .env.local and fill in.

# Postgres (Neon has a free tier: https://neon.tech)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Nebius Token Factory key: https://tokenfactory.nebius.com (API keys)
NEBIUS_API_KEY=
# Optional model fallback lists; defaults are in lib/llm/nebius.ts.
# Flash first builds workflows for ~$0.001 instead of ~$0.015, but takes 10-30 s instead of ~5 s.
# NEBIUS_COMPILER_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,deepseek-ai/DeepSeek-V4-Pro
# NEBIUS_SUMMARY_MODELS=Qwen/Qwen3-235B-A22B-Instruct-2507,Qwen/Qwen3-30B-A3B-Instruct-2507
# Encrypts saved credentials. Generate with: npm run keygen
# Don't just replace it later; rotate with npm run reencrypt.
ENCRYPTION_KEY=

# Email sender. onboarding@resend.dev works without setup but only delivers to
# the address you signed up to Resend with. To email anyone else, verify a
# domain in Resend and use an address on it.
RESEND_FROM=onboarding@resend.dev

# Optional: Jina Reader key for JavaScript-heavy pages (https://jina.ai/reader).
# Without one, the free keyless limit applies (about 20 pages a minute per IP).
# JINA_API_KEY=

# Optional: treat schedule units as seconds instead of minutes (for demos).
DEMO_MODE=false

# Optional: base URL for approval links in Slack. Defaults to VERCEL_URL, then http://localhost:3000.
APP_URL=

# Required in production: POST /api/tick needs "Authorization: Bearer <TICK_SECRET>".
# Point an external cron at it so schedules run with no browser tab open.
TICK_SECRET=
